# VIACO Website — Environment Configuration
# Copy this file to .env.local for local development, or configure per environment
# (Development / Preview / Production) in Vercel Project Settings.
# Never commit real credentials or place secrets into NEXT_PUBLIC_* variables.

# Canonical public site URL (used for metadata, Open Graph, sitemap.xml, and robots.txt)
# Set to https://viaco.at once production domain DNS is approved and connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email displayed in Footer, Legal Notice (Impressum), Privacy Policy, and mailto fallback
NEXT_PUBLIC_CONTACT_EMAIL=office@viaco.at

# Optional: Official VIACO LinkedIn company page URL (omitted cleanly when blank)
NEXT_PUBLIC_LINKEDIN_URL=

# Optional: Set to "false" to disable Vercel Web Analytics & Speed Insights globally
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Server-only: Approved CRM or transactional email webhook URL for /api/demo-request delivery
# When unset, validated inquiries transparently offer a pre-filled mailto draft to office@viaco.at.
CRM_WEBHOOK_URL=

# Server-only: Bearer token sent in Authorization header when posting to CRM_WEBHOOK_URL
CRM_WEBHOOK_AUTH_TOKEN=
